# `./scripts/init-env.sh` が実機固有値を設定します。
# 実ファイルの `.env` はGit管理されません（`.gitignore` の `.env` / `.env.*`）。
# APIキー等の秘密情報はこのexampleにはプレースホルダのみを置き、実値は `.env` だけへ入れます。
M5_MODEL=
M5_FQBN=
M5_PORT=
M5_USB_SERIAL=
M5_USB_VID=
M5_USB_PID=

# --- LLM / API ---
# DeepSeek APIキー（OpenAI互換。primaryの頭脳）。実キーは `.env` のみへ。
# 取得: https://platform.deepseek.com  残高はプリペイド式＝チャージ額が上限。
DEEPSEEK_API=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OpenAI互換のBase URLとモデル（AI_StackChan_Ex等の差し替え用）。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
OPENAI_KEY=