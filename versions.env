# 公式M5Stack Board Manager。Arduino CLIはこの索引のSHA-256を検証します。
M5_BOARD_INDEX_URL=https://static-cdn.m5stack.com/resource/arduino/package_m5stack_index.json
M5_CORE_VERSION=3.3.8

# Arduino Library Managerで固定する公式ライブラリ。
M5UNIFIED_VERSION=0.2.19
M5GFX_VERSION=0.2.26
M5CARDPUTER_VERSION=1.1.1
ARDUINOWEBSOCKETS_VERSION=0.5.4
IRREMOTEESP8266_VERSION=2.9.0
M5UNIT_NFC_VERSION=0.1.0

# StackChanの公式ソース。BSP 1.1.0はLibrary Manager未掲載のためコミットも固定する。
STACKCHAN_BSP_VERSION=1.1.0
STACKCHAN_BSP_COMMIT=f7ed40e6f5d9a1d08440cb926f3a0865b81882f8
STACKCHAN_UPSTREAM_COMMIT=b72b3ede38b32d54f0b6ba51c62cfcef2ec3ae1e
STACKCHAN_FIRMWARE_VERSION=1.4.3

# stack-chanコミュニティのK151向け安定版。配布ZIPを固定ハッシュで検証する。
STACKCHAN_COMMUNITY_VERSION=1.0.0
STACKCHAN_COMMUNITY_URL=https://github.com/stack-chan/stack-chan/releases/download/v1.0.0/stack-chan-firmware-v1.0.0.zip
STACKCHAN_COMMUNITY_SHA256=faeac3ffccce899aaedde9f9a1045ff961e47f4b7c240d770285f34512e40d9a

# StackChan量産ファームウェアが指定するESP-IDF。COMMITは注釈付きタグの実体。
ESP_IDF_VERSION=5.5.4
ESP_IDF_COMMIT=735507283d5b2f9fb363a1901172dbd9e847945d

# flake.lock内のNixpkgsから提供するCLI。
ARDUINO_CLI_VERSION=1.5.1
ESPTOOL_VERSION=5.3.1
