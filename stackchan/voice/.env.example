# StackChan音声版（StackChan/CoreS3）の設定。
# 実ファイル `stackchan/voice/.env` はGit管理されません（`.gitignore` の `.env`）。
# build.shがこの値を無視対象の stackchan_voice_secrets.h へ生成します。
# 実キーはこのexampleに書かないこと。実値は `.env` だけへ。

# 接続先Wi-Fi（2.4GHz）。
WIFI_SSID=change-me
WIFI_PASSWORD=change-me

# DeepSeek（OpenAI互換・頭脳）。プリペイド残高＝上限。https://platform.deepseek.com
DEEPSEEK_API=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_HOST=api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# クラウドSTT（音声→文字）。既定はOpenAI Whisper。GroqにするならHOST/pathを合わせる。
STT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STT_HOST=api.openai.com
STT_MODEL=whisper-1

# 使いすぎ防止。1か月の目安コスト（USD）。超過で画面警告。
MONTHLY_BUDGET_USD=5

# --- localプロファイル（PC上のOpenAI互換サーバへ切替） ---
# 起動時の既定モード（0=cloud, 1=local）。実行中は画面上部タップで即切替。
PREFER_LOCAL=0
# PCのLAN IP（例 192.168.1.50）またはmDNS名。空ならlocalは到達不可扱い。
LOCAL_HOST=
# ローカルLLM（Ollama: 11434 / OpenAI互換 /v1/chat/completions）。
LOCAL_LLM_PORT=11434
LOCAL_LLM_MODEL=qwen2.5:3b
LOCAL_LLM_KEY=ollama
# ローカルSTT（faster-whisper系 OpenAI互換サーバ /v1/audio/transcriptions）。
LOCAL_STT_PORT=8000
LOCAL_STT_MODEL=Systran/faster-whisper-small
