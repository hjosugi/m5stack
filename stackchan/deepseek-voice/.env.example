# DeepSeek音声版（StackChan/CoreS3）の設定。
# 実ファイル `stackchan/deepseek-voice/.env` はGit管理されません（`.gitignore` の `.env`）。
# build.shがこの値を無視対象の deepseek_voice_secrets.h へ生成します。
# 実キーはこのexampleに書かないこと。実値は `.env` だけへ。

# 接続先Wi-Fi（2.4GHz）。
WIFI_SSID=change-me
WIFI_PASSWORD=change-me

# DeepSeek（OpenAI互換・頭脳）。プリペイド残高＝上限。https://platform.deepseek.com
DEEPSEEK_API=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_HOST=api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# クラウドSTT（音声→文字）。既定はOpenAI Whisper。GroqにするならHOST/pathを合わせる。
STT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STT_HOST=api.openai.com
STT_MODEL=whisper-1

# 使いすぎ防止。1か月の目安コスト（USD）。超過で画面警告。
MONTHLY_BUDGET_USD=5
